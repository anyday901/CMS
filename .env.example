APP_NAME=CMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# A WHMCS database to import from with php artisan whmcs:import (see docs/install.md).
# WHMCS_DB_HOST=127.0.0.1
# WHMCS_DB_PORT=3306
# WHMCS_DB_DATABASE=whmcs
# WHMCS_DB_USERNAME=
# WHMCS_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Account security. These can also be changed on the admin Security page.
SECURITY_LOCKOUT_ATTEMPTS=5
SECURITY_LOCKOUT_MINUTES=15
SECURITY_BAN_AFTER_FAILURES=20
SECURITY_BAN_HOURS=24
SECURITY_LOGIN_HISTORY_DAYS=90
SECURITY_STAFF_TWO_FACTOR=false
# CAPTCHA on public forms: turnstile, hcaptcha or recaptcha (v2 checkbox). Leave blank for none.
CAPTCHA_PROVIDER=
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# Portal theme and white-label. These can also be changed under Settings > Appearance.
THEME=harbor
BRANDING_COLOR=
BRANDING_ADMIN_NAME=
BRANDING_HIDE_POWERED_BY=false

# Maintenance mode for the portal and store (Settings > Maintenance). Staff still get in.
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=

# Database backups (Settings > Backups): daily, weekly or off; BACKUPS_DISK copies each one to a filesystem disk such as s3.
BACKUPS_SCHEDULE=daily
BACKUPS_TIME=01:30
BACKUPS_KEEP=14
BACKUPS_DISK=

# The web installer at /install, until the first staff account exists.
INSTALLER_ENABLED=true

# One-click updates from GitHub releases (Settings > Updates).
UPDATES_ENABLED=true
UPDATES_REPOSITORY=anyday901/CMS

# Add-on and theme marketplace (Settings > Marketplace). Set MARKETPLACE_INSTALLS=false to only browse.
MARKETPLACE_REGISTRY_URL=https://anyday901.github.io/CMS/marketplace/registry.json
MARKETPLACE_INSTALLS=true

# Lists each check's status at /health?token=...
HEALTH_TOKEN=

# A public demo instance: sample data, logins shown, no email, reset every few hours. Never on a real install.
DEMO_MODE=false
DEMO_RESET_HOURS=3
